# Cấu hình app. Copy file này thành .env rồi chỉnh nếu cần.
# KHÔNG đặt ANTHROPIC_API_KEY ở đây: app dùng tài khoản Claude đã đăng nhập (claude login).

# Cổng chạy web app
PORT=8000

# Số phiên chạy tự động tối đa mỗi ngày
MAX_DAILY_RUNS=10

# Số lượt (turns) tối đa cho mỗi phiên nghiên cứu
MAX_TURNS=50
